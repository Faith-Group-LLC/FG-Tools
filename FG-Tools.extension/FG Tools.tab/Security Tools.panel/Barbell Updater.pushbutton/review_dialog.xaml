<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Intersecting Pairs Found"
        Width="660" Height="500"
        MinWidth="400" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="summary_label" Grid.Row="0" FontWeight="Bold"
                   Margin="0,0,0,10" TextWrapping="Wrap"/>
        <ListBox x:Name="pairs_list" Grid.Row="1" Margin="0,0,0,14"
                 FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 IsHitTestVisible="False" Focusable="False"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="proceed_button" Content="Proceed to Update Selection"
                    Width="210" Height="28" Margin="0,0,10,0"/>
            <Button x:Name="abort_button" Content="Abort"
                    Width="80" Height="28"/>
        </StackPanel>
    </Grid>
</Window>
